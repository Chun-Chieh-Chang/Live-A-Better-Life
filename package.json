{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "setup": "tsx scripts/bootstrap.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/browser.mjs",
    "account:setup": "node --import tsx scripts/account.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "test:personal-browser": "npm run build && node tests/personal-browser.mjs",
    "backup:scheduled": "node --import tsx scripts/scheduled-backup.ts",
    "test:windows-scripts": "powershell.exe -NoProfile -File tests/windows-scripts.ps1",
    "test:activation-repair": "powershell.exe -NoProfile -File tests/activation-repair.ps1",
    "test:obsidian-browser": "npm run build && node tests/obsidian-browser.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "1.57.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
