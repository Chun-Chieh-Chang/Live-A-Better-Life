# GEMINI_API_KEY: Optional alternative provider key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local-only by default. Personal mode needs a persistent volume and owner setup.
# LIFE_OS_MODE=personal
# LIFE_OS_DB_PATH=/var/lib/life-os/owner.sqlite
# LIFE_OS_ORIGIN=https://life-os.example.com
# GEMINI_MODEL=your-available-model

# Default selection: Agnes when its key is configured, otherwise Gemini.
AI_PROVIDER="auto"
AGNES_MODEL="agnes-3.0-flash"
# Optional for development only; Windows loads the private encrypted key file.
AGNES_API_KEY=""
# Agnes endpoint is fixed server-side: https://apihub.agnes-ai.com/v1
